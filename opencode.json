{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "bun run ci": "allow",
      "bun run typecheck *": "allow",
      "bun run clean *": "allow",
      "bun run deps *": "allow",
      "bun run format *": "allow",
      "bun run format:fix *": "allow",
      "bun run test *": "allow",
      "bun run build *": "allow"
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 4096
  }
}
