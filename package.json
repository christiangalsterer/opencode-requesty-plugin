{
  "name": "opencode-requesty-plugin",
  "version": "0.1.0",
  "description": "opencode TUI plugin: shows Requesty.ai monthly budget, current spend, and per-model cost distribution in the session sidebar, with a detail dialog via the /requesty command",
  "type": "module",
  "main": "./dist/tui.js",
  "exports": {
    ".": "./dist/tui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ci": "pnpm run clean && pnpm i --prod=false && pnpm run typecheck && pnpm run test && pnpm run build",
    "build": "tsup",
    "clean": "pnpm run clean:dist && pnpm run clean:deps",
    "clean:dist": "rm -rf ./dist",
    "clean:deps": "rm -rf ./node_modules && pnpm run deps",
    "deps": "pnpm i --prod=false",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsup --watch"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "requesty",
    "tui",
    "cost-tracking"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16",
    "@opentui/core": "^0.5.1",
    "@opentui/keymap": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.12",
    "tsup": "^8.3.5",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3"
  }
}