{
  "name": "@christiangalsterer/opencode-requesty-plugin",
  "version": "2.0.0",
  "author": {
    "name": "Christian Galsterer"
  },
  "license": "MIT",
  "description": "opencode TUI plugin: shows Requesty.ai monthly budget, current spend, and per-model cost distribution in the session sidebar, in the session prompt and with a detail dialog via the /requesty command",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "opencode-tui-plugin",
    "requesty",
    "tui",
    "cost-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiangalsterer/opencode-requesty-plugin.git"
  },
  "homepage": "https://github.com/christiangalsterer/opencode-requesty-plugin#readme",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "opencode": ">=1.18.16 <3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode-ai/plugin": "1.18.32",
    "@opencode-ai/sdk": "1.18.32",
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/keymap": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "renovate": "44.149.3",
    "solid-js": "1.9.15",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.16 <2",
    "@opencode-ai/sdk": ">=1.18.16 <2",
    "@opencode/plugin": "^2.0.24",
    "@opencode/client": "^2.0.24",
    "@opencode/theme": "^2.0.24",
    "@opentui/core": ">=0.5.3 <1",
    "@opentui/keymap": ">=0.5.3 <1",
    "@opentui/solid": ">=0.5.3 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    }
  },
  "overrides": {
    "solid-js": "$solid-js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ci": "bun run clean && bun install --frozen-lockfile && bun test && bun run build && bun run package:check && bun run renovate:config && bun pm pack --ignore-scripts && npm i --omit=dev --dry-run *.tgz",
    "biome": "biome check",
    "biome:fix": "biome check --write",
    "build": "bun run typecheck && bun run build.ts",
    "clean": "bun run clean:dist && bun run clean:deps",
    "clean:dist": "rm -rf ./dist && rm -rf christiangalsterer-opencode-requesty-plugin*.tgz && mkdir -p ./dist",
    "clean:deps": "rm -rf ./node_modules && bun run deps",
    "docker:build:v1": "docker build -f Dockerfile.v1 -t opencode-requesty-plugin:v1 .",
    "docker:run:v1": "bun run build && docker run --rm -it -v \"$HOME\"/.config/opencode/opencode.json:/home/harness/.config/opencode/opencode.json:ro -v \"$PWD\":/home/harness/plugin:ro -v \"$PWD\"/docker/tui-v1.json:/home/harness/workspace/.opencode/tui.json:ro -e REQUESTY_API_KEY=\"$REQUESTY_API_KEY\" opencode-requesty-plugin:v1",
    "docker:build:v2": "docker build -f Dockerfile.v2 -t opencode-requesty-plugin:v2 .",
    "docker:run:v2": "bun run build && docker run --rm -it -v \"$HOME\"/.config/opencode/opencode.json:/home/harness/.config/opencode/opencode.json:ro -v \"$PWD\":/home/harness/plugin:ro -v \"$PWD\"/docker/tui.ts:/home/harness/workspace/.opencode/plugins/requesty/tui.ts:ro -e REQUESTY_API_KEY=\"$REQUESTY_API_KEY\" opencode-requesty-plugin:v2",
    "deps": "bun install",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "husky": "bun run format:fix",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun test",
    "test:coverage": "bun run typecheck && bun test --coverage",
    "release:prepare": "bun run clean && bun install && bun run format && bun test",
    "package:check": "bun scripts/check-package-artifact.ts",
    "publish-npm": "bun run ci && bun publish --access=public",
    "publish-npm:dry-run": "bun run ci && bun publish --access=public --dry-run",
    "prepare": "husky",
    "renovate:config": "npx renovate-config-validator"
  },
  "lint-staged": {
    "*": "bun run husky"
  }
}
