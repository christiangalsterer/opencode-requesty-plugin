{
  "name": "@christiangalsterer/opencode-requesty-plugin",
  "version": "1.3.1",
  "author": {
    "name": "Christian Galsterer"
  },
  "license": "MIT",
  "description": "opencode TUI plugin: shows Requesty.ai monthly budget, current spend, and per-model cost distribution in the session sidebar, in the session prompt and with a detail dialog via the /requesty command",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "opencode-tui-plugin",
    "requesty",
    "tui",
    "cost-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiangalsterer/opencode-requesty-plugin.git"
  },
  "homepage": "https://github.com/christiangalsterer/opencode-requesty-plugin#readme",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "opencode": "^1.18.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@opencode-ai/plugin": "1.18.32",
    "@opencode-ai/sdk": "1.18.32",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "solid-js": "1.9.15",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.16 <2",
    "@opencode-ai/sdk": ">=1.18.16 <2",
    "@opentui/core": ">=0.5.3 <1",
    "@opentui/keymap": ">=0.5.3 <1",
    "@opentui/solid": ">=0.5.3 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "overrides": {
    "solid-js": "$solid-js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ci": "bun run clean && bun install && bun test && bun run build && bun pm pack && npm i --omit=dev --dry-run *.tgz",
    "biome": "biome check",
    "biome:fix": "biome check --write",
    "build": "bun run typecheck && bun run build.ts",
    "clean": "bun run clean:dist && bun run clean:deps",
    "clean:dist": "rm -rf ./dist && rm -rf christiangalsterer-opencode-requesty-plugin*.tgz && mkdir -p ./dist",
    "clean:deps": "rm -rf ./node_modules && bun run deps",
    "docker:build": "docker build -t opencode-requesty-plugin .",
    "docker:run": "docker run --rm -it -v \"$HOME\"/.config/opencode/opencode.json:/home/alice/.config/opencode/opencode.json:ro -v \"$PWD\":/home/alice/plugin:ro -e REQUESTY_API_KEY=\"$REQUESTY_API_KEY\" opencode-requesty-plugin",
    "deps": "bun install",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "husky": "bun run format:fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun test",
    "test:coverage": "bun run typecheck && bun test --coverage",
    "release:prepare": "bun run clean && bun install && bun run format && bun test",
    "publish-npm": "bun run ci && bun publish --access=public",
    "publish-npm:dry-run": "bun run ci && bun publish --access=public --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "bun run husky"
  }
}